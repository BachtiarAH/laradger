APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI journal draft generation. Providers are swappable via AI_DEFAULT_PROVIDER.
AI_DEFAULT_PROVIDER=openai
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional OpenAI-compatible provider (e.g. any OpenAI-compatible gateway/endpoint).
# Example: Google Gemini via its OpenAI-compatible endpoint:
#   AI_COMPATIBLE_BASE_URI=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_COMPATIBLE_API_KEY=<gemini-api-key>
#   AI_COMPATIBLE_MODEL=gemini-3.7-flash
#   AI_COMPATIBLE_ENDPOINT=/chat/completions
AI_COMPATIBLE_BASE_URI=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_COMPATIBLE_ENDPOINT=

# Custom system prompt for draft generation. Leave empty for the built-in default.
# Placeholders: :accounts (chart of accounts) and :statement (user input).
AI_PROMPT=

# AI call recording (prompt, response, token usage, latency + confirmation).
# Swap backends by changing AI_RECORDING_DRIVER.
AI_RECORDING_ENABLED=true
AI_RECORDING_DRIVER=file
AI_RECORDING_PATH=logs/ai-calls.jsonl

VITE_APP_NAME="${APP_NAME}"
